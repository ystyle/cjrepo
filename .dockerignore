# Git (保留 .git 用于构建时获取版本信息)
.gitignore
# 只保留 .git 的必要部分
.git/*
!.git/HEAD
!.git/refs/
!.git/objects/

# 数据和存储目录（会被 volume 挂载）
data/
storage/

# Go 相关
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
go.work
cjrepo

# Frontend（将在 Docker 中构建）
frontend/node_modules/
frontend/dist/
.frontend/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# 操作系统
.DS_Store
Thumbs.db

# 日志
*.log

# 文档
*.md
!README.md

# 其他
.env
